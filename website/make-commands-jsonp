#!/usr/bin/env bash
#
# Create the JSONP file for the commands to execute on index.html using the
# terminal emulator as seen from the web browser.
#
# Author: Dave Eddy <dave@daveeddy.com>
# Date: April 03, 2025
# License: MIT

# we can declare multiple commands here, but for now i just like having 1
cmd_keys=('curl -L mhpx.pages.dev')
cmd_vals=("$(./make-index | ./tools/bansi-to-html -H)")

inputs=()
for ((i = 0; i < ${#cmd_keys[@]}; i++)); do
	cmd=${cmd_keys[i]}
	output=${cmd_vals[i]}
	s=$(python3 -c '
import sys, json
cmd = sys.argv[1]
lines = sys.stdin.read().split("\n")
if lines and lines[-1] == "":
    lines.pop()
print(json.dumps({"cmd": cmd, "lines": lines}))
' "$cmd" <<< "$output") || exit 1
	inputs+=("$s")
done

json=$(printf '%s\n' "${inputs[@]}" | python3 -c '
import sys, json
lines = [json.loads(line) for line in sys.stdin.read().split("\n") if line]
print(json.dumps(lines))
') || exit 1
echo "const COMMANDS = $json;"
